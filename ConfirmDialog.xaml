<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="MoonDropEQ.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="确认"
                 Icon="/Assets/app.png"
                 Width="400"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="确认" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,20">
            <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" LineHeight="22"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" Height="32" Width="84"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="确定" Height="32" Width="84" Margin="8,0,0,0"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
