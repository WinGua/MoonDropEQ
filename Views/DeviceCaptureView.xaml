<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MoonDropEQ.Views.DeviceCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="#082430" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,4,20,20" MaxWidth="820" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppAccentBrush}"
                   Text="采集只读取耳机信息，不会写入任何设置。请先插好耳机，再按提示在浏览器里完成两次操作。" />

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,16,0,0" FontSize="14"
                   TextWrapping="Wrap" LineHeight="22"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   Text="请先插好耳机，然后点「开始采集」。" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="BuiltInCheck" FontSize="13" Margin="0,0,0,4"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       Text="○ 内置预设（默认）" />
            <TextBlock x:Name="CurveCheck" FontSize="13" Margin="0,0,0,4"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       Text="○ 自定义曲线" />
            <TextBlock x:Name="SavedCheck" FontSize="13"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       Text="○ 保存命令" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10" CornerRadius="6"
                Background="{DynamicResource AppSurfaceMutedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" FontSize="12" LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                           Text="等待开始。" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="OpenFolderButton" Content="打开文件夹" Height="32"
                    HorizontalAlignment="Left" Visibility="Collapsed"
                    Click="OpenFolder_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Height="32" Width="84"
                        Click="Cancel_Click" />
                <Button x:Name="FinishButton" Content="完成采集" Height="32" Width="96"
                        Margin="8,0,0,0" IsEnabled="False" Click="Finish_Click" />
                <Button x:Name="StartButton" Content="开始采集" Height="32" Width="96"
                        Margin="8,0,0,0" Style="{StaticResource PrimaryDialogButtonStyle}"
                        Click="Start_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
