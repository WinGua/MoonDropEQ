<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MoonDropEQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,20">
            <TextBlock Text="关闭窗口时" FontSize="14"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
            <RadioButton x:Name="CloseToTrayRadio" GroupName="CloseBehavior" Content="最小化到托盘，热键继续可用"
                         Margin="0,10,0,0" Checked="CloseToTray_Checked" />
            <RadioButton x:Name="ExitRadio" GroupName="CloseBehavior" Content="直接退出程序"
                         Margin="0,4,0,0" Checked="Exit_Checked" />

            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource AppBorderBrush}" />

            <TextBlock Text="窗口材质" FontSize="14"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
            <RadioButton x:Name="MicaRadio" GroupName="Backdrop" Content="Mica（云母，推荐）"
                         Margin="0,10,0,0" Checked="Mica_Checked" />
            <RadioButton x:Name="AcrylicRadio" GroupName="Backdrop" Content="亚克力（磨砂）"
                         Margin="0,4,0,0" Checked="Acrylic_Checked" />
            <RadioButton x:Name="SolidRadio" GroupName="Backdrop" Content="纯色（无材质，性能最好）"
                         Margin="0,4,0,0" Checked="Solid_Checked" />

            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource AppBorderBrush}" />

            <TextBlock Text="主题" FontSize="14"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
            <RadioButton x:Name="SystemThemeRadio" GroupName="Theme" Content="跟随系统"
                         Margin="0,10,0,0" Checked="SystemTheme_Checked" />
            <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="深色"
                         Margin="0,4,0,0" Checked="DarkTheme_Checked" />
            <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="浅色"
                         Margin="0,4,0,0" Checked="LightTheme_Checked" />

            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource AppBorderBrush}" />

            <TextBlock Text="界面缩放" FontSize="14"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
            <RadioButton x:Name="Scale90Radio" GroupName="UiScale" Content="90%（紧凑）"
                         Margin="0,10,0,0" Checked="Scale90_Checked" />
            <RadioButton x:Name="Scale100Radio" GroupName="UiScale" Content="100%（标准）"
                         Margin="0,4,0,0" Checked="Scale100_Checked" />
            <RadioButton x:Name="Scale110Radio" GroupName="UiScale" Content="110%（较大）"
                         Margin="0,4,0,0" Checked="Scale110_Checked" />
            <RadioButton x:Name="Scale125Radio" GroupName="UiScale" Content="125%（最大）"
                         Margin="0,4,0,0" Checked="Scale125_Checked" />

            <TextBlock Margin="0,18,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       Text="材质、主题与界面缩放会立即生效；设置保存在 %APPDATA%\MoonDropEQ\settings.json" />

            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource AppBorderBrush}" />

            <Button Content="打开预设文件位置" Height="32" Padding="14,0"
                    HorizontalAlignment="Left" Click="OpenPresetFile_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
