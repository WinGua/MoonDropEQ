<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MoonDropEQ.Views.DeviceAdapterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  MaxWidth="820" HorizontalAlignment="Center">
        <StackPanel Margin="20,4,20,20" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="如果你使用的是尚未适配的水月雨耳机，可以在这里采集信息，帮助作者添加支持。采集只读取耳机信息，不会写入任何设置。" />

            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource AppSurfaceMutedBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前设备" FontSize="12"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <TextBlock x:Name="DeviceText" Grid.Column="1" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="上次采集" FontSize="12"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <TextBlock x:Name="LastCaptureText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="采集包" FontSize="12"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <TextBlock x:Name="PackageCountText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="设备采集" Height="36" HorizontalAlignment="Stretch"
                        Click="Capture_Click" />
                <Button Grid.Column="1" Content="采集数据" Height="36" Margin="8,0,0,0"
                        HorizontalAlignment="Stretch" Click="OpenData_Click" />
                <Button Grid.Column="2" Content="采集提交" Height="36" Margin="8,0,0,0"
                        HorizontalAlignment="Stretch" Click="Submit_Click" />
            </Grid>

            <TextBlock x:Name="HintText" Margin="0,10,0,0" FontSize="12"
                       TextWrapping="Wrap" LineHeight="18"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" />

            <TextBlock Margin="0,18,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppAccentBrush}"
                       Text="采集流程：插好耳机 → 点「设备采集」→ 在打开的网页里应用一次「默认」和一条「自定义曲线」→ 点「完成采集」→ 点「采集提交」。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
