<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MoonDropEQ.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,4,20,12">
                <StackPanel Orientation="Horizontal">
                    <Image Width="56" Height="56" Source="/Assets/app.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MoonDropEQ" FontSize="18"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="0,18,0,0" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="水月雨 MOONDROP耳机的桌面 EQ 预设遥控器：把官网的「选设备 → 开始使用 → 挑预设 → 应用」压缩成一次点击或一个热键。" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="支持设备" Height="32" Padding="14,0" Click="SupportedDevices_Click" />
                    <Button Content="GitHub 仓库" Height="32" Padding="14,0" Margin="8,0,0,0" Click="Repo_Click" />
                    <Button Content="问题反馈" Height="32" Padding="14,0" Margin="8,0,0,0" Click="Issues_Click" />
                </StackPanel>

                <TextBlock Margin="0,18,0,8" Text="快速上手" FontSize="14"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />

                <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="1. 插上耳机并启动本程序，顶部显示「已连接」即可使用。" />
                <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="2. 点击任意预设卡片，或按对应热键切换（默认 Ctrl+Alt+1 ~ 5）。" />
                <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="3. 想加自己的曲线：先在官网应用一次，再回来点「抓取当前曲线」并命名。" />
                <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="4. 关闭窗口会收进托盘，热键依然可用；托盘图标单击唤回窗口。" />

                <Border Margin="0,18,0,0" Padding="14" CornerRadius="8"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="版本更新" FontSize="14"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="UpdateStatus" Margin="0,6,0,0" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="点击下方按钮检查是否有新版本" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CheckButton" Content="检查更新" Height="32"
                                    Click="CheckUpdate_Click" />
                            <Button x:Name="DownloadButton" Content="前往下载" Height="32"
                                    Margin="8,0,0,0" Visibility="Collapsed"
                                    Click="Download_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Margin="0,0,0,14" HorizontalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                   Text="Built by Winter with DeepSeek" />
    </Grid>
</UserControl>
