<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="MoonDropEQ.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:MoonDropEQ.Views"
                 Title="MoonDropEQ"
                 Icon="/Assets/app.png"
                 Width="976" Height="636"
                 MinWidth="656" MinHeight="496"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="PresetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="MoonDropEQ" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid x:Name="MainView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="16,4,16,10"
                        Padding="12,10"
                        CornerRadius="8"
                        Background="{DynamicResource AppSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource AppDangerBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" Text="正在查找耳机…"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="ActiveText" Margin="12,0,0,0" Text=""
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid Margin="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SideColumn" Width="280" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="预设" FontSize="16"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="点击应用 · 右键更多" HorizontalAlignment="Right"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" x:Name="PresetScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PresetList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PresetCardStyle}"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="PresetCard_Click"
                                                    MouseRightButtonUp="PresetCard_RightClick">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                        <Border Grid.Column="1" Width="6" Height="6" CornerRadius="3"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource AppAccentBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Text="{Binding KindText}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource AppTextTertiaryBrush}" />

                                                    <Border Grid.Row="2" Padding="8,3" CornerRadius="4"
                                                            Margin="0,8,0,0" HorizontalAlignment="Left"
                                                            Background="{DynamicResource AppSurfaceBrush}"
                                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding HotkeyText}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border x:Name="SidePanel" Grid.Column="1"
                                Padding="14" CornerRadius="8"
                                Background="{DynamicResource AppSurfaceMutedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="当前预设" FontSize="12"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="SideCurrentName" Text="未选择" FontSize="18" Margin="0,4,0,0"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="SideCurrentMeta" Text="点击左侧卡片应用" FontSize="12"
                                           Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="SideRenameButton" Content="重命名" Height="28" Padding="10,0"
                                            FontSize="12" IsEnabled="False" Click="SideRename_Click" />
                                    <Button x:Name="SideHotkeyButton" Content="热键" Height="28" Padding="10,0"
                                            FontSize="12" Margin="6,0,0,0" IsEnabled="False" Click="SideHotkey_Click" />
                                    <Button x:Name="SideDeleteButton" Content="删除" Height="28" Padding="10,0"
                                            FontSize="12" Margin="6,0,0,0" IsEnabled="False" Click="SideDelete_Click" />
                                </StackPanel>

                                <Border Height="1" Margin="0,14,0,12"
                                        Background="{DynamicResource AppBorderBrush}" />

                                <TextBlock Text="设备" FontSize="12"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="SideDeviceName" Text="未连接" FontSize="14" Margin="0,4,0,0"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="SideDeviceMeta" Text="插入耳机后自动识别" FontSize="12"
                                           Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="18"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />

                                <Border Height="1" Margin="0,14,0,12"
                                        Background="{DynamicResource AppBorderBrush}" />

                                <TextBlock Text="显示" FontSize="12"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="界面缩放" FontSize="12"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock x:Name="SideScaleText" Text="100%" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                </Grid>
                                <Button Content="调整" Height="28" Padding="10,0" FontSize="12"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="SideScale_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="Toast" Margin="16,0,16,16" VerticalAlignment="Bottom"
                            Padding="12,8" CornerRadius="6" Visibility="Collapsed"
                            Background="{DynamicResource AppToastBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,4,16,10">
                    <Button Content="← 返回" Height="32" Padding="12,0" Click="Back_Click" />
                    <TextBlock Text="设置" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
                <views:SettingsView x:Name="SettingsPage" Grid.Row="1"
                                    MaxWidth="780" HorizontalAlignment="Left" />
            </Grid>

            <Grid x:Name="DeviceHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,4,16,10">
                    <Button Content="← 返回" Height="32" Padding="12,0" Click="Back_Click" />
                    <TextBlock Text="设备适配" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
                <views:DeviceAdapterView x:Name="DevicePage" Grid.Row="1"
                                         MaxWidth="780" HorizontalAlignment="Left" />
            </Grid>

            <Grid x:Name="AboutHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,4,16,10">
                    <Button Content="← 返回" Height="32" Padding="12,0" Click="Back_Click" />
                    <TextBlock Text="关于" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
                <views:AboutView Grid.Row="1" MaxWidth="780" HorizontalAlignment="Left" />
            </Grid>
        </Grid>

        <UniformGrid x:Name="FooterGrid" Grid.Row="2" Columns="4" Margin="12,8,12,12">
            <ui:Button x:Name="CaptureButton" Content="抓取曲线" Height="36"
                       Appearance="Primary" Margin="4,2"
                       Click="CaptureButton_Click" />
            <ui:Button Content="设备适配" Height="36" Margin="4,2"
                       Appearance="Secondary" Click="Device_Click" />
            <ui:Button Content="设置" Height="36" Margin="4,2"
                       Appearance="Secondary" Click="Settings_Click" />
            <ui:Button Content="关于" Height="36" Margin="4,2"
                       Appearance="Secondary" Click="About_Click" />
        </UniformGrid>
    </Grid>
</ui:FluentWindow>
