<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="MoonDropEQ.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:MoonDropEQ.Views"
                 Title="MoonDropEQ"
                 Icon="/Assets/app.png"
                 Width="560" Height="720"
                 MinWidth="480" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="PresetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="MoonDropEQ" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid x:Name="MainView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="16,4,16,10"
                        Padding="12,10"
                        CornerRadius="8"
                        Background="{DynamicResource AppSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource AppDangerBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" Text="正在查找耳机…"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="ActiveText" Margin="12,0,0,0" Text=""
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PresetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCardStyle}"
                                            Tag="{Binding}"
                                            MouseLeftButtonUp="PresetCard_Click"
                                            MouseRightButtonUp="PresetCard_RightClick">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding KindText}" FontSize="12" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppSurfaceBrush}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding HotkeyText}" FontFamily="Consolas" FontSize="12"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Margin="0,10,0,0">
                                                <Button Content="重命名" Height="28" Padding="12,0" FontSize="12"
                                                        Tag="{Binding}" Click="Rename_Click" />
                                                <Button Content="设置热键" Height="28" Padding="12,0" FontSize="12"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="Hotkey_Click" />
                                                <Button Content="删除" Height="28" Padding="12,0" FontSize="12"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="Delete_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border x:Name="Toast" Margin="16,0,16,16" VerticalAlignment="Bottom"
                            Padding="12,8" CornerRadius="6" Visibility="Collapsed"
                            Background="{DynamicResource AppToastBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,4,16,10">
                    <Button Content="← 返回" Height="32" Padding="12,0" Click="Back_Click" />
                    <TextBlock Text="设置" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
                <views:SettingsView Grid.Row="1" />
            </Grid>

            <Grid x:Name="AboutHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,4,16,10">
                    <Button Content="← 返回" Height="32" Padding="12,0" Click="Back_Click" />
                    <TextBlock Text="关于" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
                <views:AboutView Grid.Row="1" />
            </Grid>
        </Grid>

        <Grid x:Name="FooterPanel" Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CaptureButton" Content="抓取当前曲线" Height="36"
                    HorizontalAlignment="Stretch" Click="CaptureButton_Click" />
            <Button Grid.Column="1" Content="配置文件" Height="36" Margin="8,0,0,0"
                    Click="OpenConfig_Click" />
            <Button Grid.Column="2" Content="设置" Height="36" Margin="8,0,0,0"
                    Click="Settings_Click" />
            <Button Grid.Column="3" Content="关于" Height="36" Margin="8,0,0,0"
                    Click="About_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
