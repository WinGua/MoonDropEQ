{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoonDropEQ device profile",
  "description": "描述一台水月雨耳机的 HID 协议参数。新增设备时在 Core/devices.json 中添加一条符合本 schema 的记录。",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "vendorId",
    "productIds",
    "reportId",
    "readOp",
    "writeOp",
    "bandCount",
    "bandPayloadSize",
    "curveSlot",
    "slots",
    "commands",
    "capabilities",
    "timing"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "唯一标识，例如 rays"
    },
    "name": {
      "type": "string",
      "description": "界面显示名称"
    },
    "vendorId": {
      "$ref": "#/definitions/hex"
    },
    "productIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/hex"
      }
    },
    "reportId": {
      "$ref": "#/definitions/hex"
    },
    "readOp": {
      "$ref": "#/definitions/hex"
    },
    "writeOp": {
      "$ref": "#/definitions/hex"
    },
    "bandCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "bandPayloadSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "curveSlot": {
      "type": "integer",
      "minimum": 0
    },
    "gainScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "增益换算系数，Rays 为 256"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "name"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "object",
      "required": ["eqIndex", "eqBand", "save"],
      "properties": {
        "eqIndex": {
          "$ref": "#/definitions/hex"
        },
        "eqBand": {
          "$ref": "#/definitions/hex"
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/definitions/hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "preGain": {
          "anyOf": [
            {
              "$ref": "#/definitions/hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "globalGain": {
          "anyOf": [
            {
              "$ref": "#/definitions/hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "save": {
          "$ref": "#/definitions/hex"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "builtInSlots",
        "curve",
        "preGain",
        "globalGain",
        "needsCommit",
        "dualChannel"
      ],
      "properties": {
        "builtInSlots": {
          "type": "boolean"
        },
        "curve": {
          "type": "boolean"
        },
        "preGain": {
          "type": "boolean"
        },
        "globalGain": {
          "type": "boolean"
        },
        "needsCommit": {
          "type": "boolean"
        },
        "dualChannel": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["switchDelayMs", "bandDelayMs", "saveDelayMs"],
      "properties": {
        "switchDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "bandDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "saveDelayMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "verified": {
      "type": "object",
      "properties": {
        "level": {
          "enum": ["official", "community", "experimental"]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "description": "对应的 Issue 或 PR 链接"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^0x[0-9A-Fa-f]{1,4}$"
    }
  }
}
